# name: test/sql/api_errors.test
# description: Point overload range / non-finite inputs throw (C++ prefers errors)
# group: [sql]

require cnshift

# SQL macros return NULL for these; the extension throws (API contract: prefer errors).

statement error
SELECT wgs84_to_gcj02(91, 0);
----
Latitude out of range

statement error
SELECT wgs84_to_gcj02(-91, 0);
----
Latitude out of range

statement error
SELECT wgs84_to_gcj02(0, 181);
----
Longitude out of range

statement error
SELECT wgs84_to_gcj02(0, -181);
----
Longitude out of range

statement error
SELECT wgs84_to_gcj02('inf'::DOUBLE, 0);
----
Latitude out of range

statement error
SELECT wgs84_to_gcj02('nan'::DOUBLE, 0);
----
Latitude out of range

statement error
SELECT wgs84_to_shcs2000(91, 0);
----
Latitude out of range

statement error
SELECT shcs2000_to_wgs84('inf'::DOUBLE, 0);
----
X coordinate out of range
